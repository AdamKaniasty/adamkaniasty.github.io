<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.seo_title | escape }}</title>
<meta name="author" content="Adam Kaniasty">
<meta name="description" content="{{ page.seo_description | escape }}">
{% if page.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
{% if site.enable_google_verification and site.google_site_verification %}
  <meta name="google-site-verification" content="{{ site.google_site_verification | escape }}">
{% endif %}
{% if site.enable_bing_verification and site.bing_site_verification %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification | escape }}">
{% endif %}
{% if site.serve_og_meta %}
  <meta property="og:site_name" content="Adam Kaniasty">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.seo_title | escape }}">
  <meta property="og:description" content="{{ page.seo_description | escape }}">
  <meta property="og:url" content="{{ page.canonical_override | default: page.canonical_url }}">
  <meta property="og:image" content="{{ page.seo_image }}">
  <meta property="og:image:alt" content="Adam Kaniasty">
  <meta property="og:locale" content="{% if page.lang == 'pl' %}pl_PL{% else %}en_GB{% endif %}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page.seo_title | escape }}">
  <meta name="twitter:description" content="{{ page.seo_description | escape }}">
  <meta name="twitter:image" content="{{ page.seo_image }}">
  <meta name="twitter:image:alt" content="Adam Kaniasty">
{% endif %}
{% if site.serve_schema_org and page.json_ld %}
  <script type="application/ld+json">
    {{ page.json_ld }}
  </script>
{% endif %}

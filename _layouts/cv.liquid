---
layout: default
---
<article class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          aria-label="Download résumé PDF"
          ><i class="fa-solid fa-file-pdf"></i
        ></a>
      {% endif %}
    </h1>
    <p class="post-description">{{ page.description }}</p>
    <p>
      <a href="{{ '/projects/' | relative_url }}">Project architecture and source links</a> ·
      <a href="{{ '/publications/' | relative_url }}">Research and publications</a>
    </p>
  </header>
  <div class="cv">
    {% for data in site.data.resume %}
      {% assign key = data[0] %}
      {% assign entries = data[1] %}
      {% if entries.size == 0 or entries == null %}{% continue %}{% endif %}
      <section class="card mt-3 p-3" aria-labelledby="{{ key }}">
        <h2 id="{{ key }}" class="card-title font-weight-medium">
          {% if key == 'basics' %}Profile{% else %}{{ key | capitalize }}{% endif %}
        </h2>
        {% case key %}
          {% when 'basics' -%}
            {%- include resume/basics.liquid %}
          {% when 'education' -%}
            {%- include resume/education.liquid %}
          {% when 'work' -%}
            {%- include resume/work.liquid %}
          {% when 'volunteer' -%}
            {%- include resume/volunteer.liquid %}
          {% when 'projects' -%}
            {%- include resume/projects.liquid %}
          {% when 'awards' -%}
            {%- include resume/awards.liquid %}
          {% when 'skills' -%}
            {%- include resume/skills.liquid %}
          {% when 'publications' -%}
            {%- include resume/publications.liquid %}
          {% when 'languages' -%}
            {%- include resume/languages.liquid %}
          {% when 'interests' -%}
            {%- include resume/interests.liquid %}
          {% when 'certificates' -%}
            {%- include resume/certificates.liquid %}
          {% when 'references' -%}
            {%- include resume/references.liquid %}
        {% endcase %}
      </section>
    {% endfor %}
  </div>
</article>
